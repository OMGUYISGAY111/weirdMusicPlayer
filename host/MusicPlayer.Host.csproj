<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MusicPlayer.Host</AssemblyName>
    <RootNamespace>MusicPlayer.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>音乐播放器</Product>

    <!-- CefSharp 必须指定具体平台，x64 与当前 CEF 二进制一致 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 前端产物目录；打包脚本 / CI 可用 -p:RendererDist=<目录> 指向别处 -->
    <RendererDist Condition="'$(RendererDist)' == ''">$(MSBuildProjectDirectory)\..\renderer\dist</RendererDist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="154.0.340" />
  </ItemGroup>

  <!-- 把 renderer/dist 一起拷到输出目录的 web/ 下，宿主优先加载它（单文件分发就够用） -->
  <Target Name="CopyRendererDist" AfterTargets="Build" Condition="Exists('$(RendererDist)\index.html')">
    <ItemGroup>
      <RendererDistFiles Include="$(RendererDist)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RendererDistFiles)" DestinationFiles="@(RendererDistFiles->'$(OutDir)web\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已复制前端产物到 $(OutDir)web（来源 $(RendererDist)）" />
  </Target>

  <!--
    publish 不会自动带上 OutDir 里自定义拷进来的文件，所以单独登记到发布清单，
    保证 dist（便携包）里始终有 web/ 目录，否则目标机器双击 exe 会找不到前端产物。
  -->
  <Target Name="PublishRendererDist" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(RendererDist)\index.html')">
    <ItemGroup>
      <RendererPublishFiles Include="$(RendererDist)\**\*.*" />
      <ResolvedFileToPublish Include="@(RendererPublishFiles)">
        <RelativePath>web\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Message Importance="high" Text="已把前端产物加入发布清单：web\（来源 $(RendererDist)）" />
  </Target>

</Project>
